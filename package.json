{
  "name": "favorit-parts",
  "private": true,
  "packageManager": "bun@1.3.5",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --mode dev",
    "build": "vite build --mode prod",
    "build:dev": "vite build --mode dev",
    "build:prod": "vite build --mode prod",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier -wl .",
    "format:check": "prettier -c .",
    "prepare": "husky",
    "gen:api": "node scripts/gen-api.js",
    "i18n:lint": "i18next-cli lint",
    "i18n:sync": "node scripts/i18n-sync.js",
    "i18n:check": "node scripts/i18n-sync.js -c -a",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=scenarios",
    "test:ui": "playwright test --project=visual",
    "test:pw": "playwright test",
    "test:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit:report": "vitest run --coverage --reporter=default --reporter=html; code=$?; vite preview --outDir .vitest --port 4173 --open; exit $code",
    "test:e2e:report": "PLAYWRIGHT_HTML_REPORT=playwright-report/e2e playwright test --project=scenarios; code=$?; playwright show-report playwright-report/e2e; exit $code",
    "test:ui:report": "PLAYWRIGHT_HTML_REPORT=playwright-report/ui playwright test --project=visual; code=$?; playwright show-report playwright-report/ui; exit $code"
  },
  "browserslist": [
    "safari >= 13.1",
    "chrome >= 109",
    "firefox >= 115",
    "edge >= 109"
  ],
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix"
    ],
    "src/**/*.{js,jsx,css,md}": [
      "prettier -w"
    ]
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/red-hat-display": "^5.3.0",
    "@fontsource/red-hat-mono": "^5.3.0",
    "@fontsource/red-hat-text": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/react-virtual": "^3.14.23",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.5.11",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-redux": "^9.3.0",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "dotenv": "^16.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "i18next-cli": "^1.80.5",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "minimist": "^1.2.8",
    "modern-normalize": "^3.0.1",
    "orval": "^8.45.0",
    "postcss": "^8.5.32",
    "postcss-preset-env": "^11.6.1",
    "prettier": "^3.9.10",
    "simple-git": "^3.36.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
